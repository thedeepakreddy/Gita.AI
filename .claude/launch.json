{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gita-counsel-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "gita-embed-service",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "scripts/embed.py",
        "serve"
      ],
      "port": 8399
    },
    {
      "name": "gita-counsel-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3000
    }
  ]
}
