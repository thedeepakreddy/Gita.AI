# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Database -------------------------------------------------------------
# SQLite for local/self-hosted. For a serverless deploy (Vercel), switch
# prisma/schema.prisma `provider` to "postgresql" and put the connection
# string here instead — SQLite does not survive an ephemeral filesystem.
DATABASE_URL="file:./dev.db"

# --- Encryption -----------------------------------------------------------
# Encrypts users' own provider API keys at rest. Generate with:
#     openssl rand -base64 32
# Rotating this makes every stored key undecryptable; users must re-enter them.
APP_ENCRYPTION_KEY=""

# --- Auth (identity only) -------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials, from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# Sign-in identifies the user AND anchors the trial allowance below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Free trial (operator-funded) -----------------------------------------
# New users get TRIAL_MESSAGE_LIMIT messages on this key before they must add
# their own. Leave TRIAL_API_KEY empty to disable the trial entirely — the app
# then behaves as pure bring-your-own-key.
#
# Use a FREE-TIER key here (Gemini or Groq) and the trial costs nothing.
# Gemini is the better choice for a *shared* key: Groq's free tier allows far
# more requests/day (14,400 vs ~250) but only 6,000 tokens/minute, and each
# turn of this app sends ~4,000 tokens of retrieved verses — so a handful of
# simultaneous users would throttle. Gemini's ~1M tokens/minute does not bind.
TRIAL_PROVIDER="gemini"
TRIAL_API_KEY=""

# Per-account allowance, spent once. Not refilled.
TRIAL_MESSAGE_LIMIT="10"

# Global ceiling per calendar day, across every user. This is the only thing
# bounding spend if someone creates accounts in bulk. Keep it below the
# provider's own free daily quota so this trips first with a clear message.
TRIAL_DAILY_CAP="200"

# --- Model overrides (optional) -------------------------------------------
# Providers retire models on their own schedule, and a retired model is the
# most likely way a working install breaks months later — an existing key often
# keeps reaching it while every new key gets a 404, so it fails silently for
# newcomers only. Check them with:  npm run models:check
# GEMINI_MODEL="gemini-3.6-flash"
# GROQ_MODEL="llama-3.3-70b-versatile"   # verify: npm run models:check
# OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_MODEL="claude-opus-5"

# --- Administration -------------------------------------------------------
# Comma-separated addresses that are ALWAYS treated as admin, whatever the
# database says. This is the key to the building: it is how a fresh deployment
# gets its first administrator, and how you get back in if a role is changed by
# mistake. Everyone else is appointed reviewer/admin from /admin.
ADMIN_EMAILS=""

# --- Retrieval ------------------------------------------------------------
# Where queries get embedded.
#   local   (default) — the ONNX encoder, inside the Next.js process. Nothing
#                       extra to run; weights download once to .hf-cache.
#   service           — POST to the Python sidecar (scripts/embed.py serve).
# Whichever you pick, it MUST match the model the index was built with. Check:
#     npm run embed:verify
EMBED_BACKEND="local"

# fp32 is the measured-parity default. q8 is ~4x smaller and slightly lossy —
# re-run embed:verify before trusting it.
# EMBED_DTYPE="fp32"

# Only read when EMBED_BACKEND="service".
EMBED_SERVICE_URL="http://127.0.0.1:8399"
