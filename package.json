    "db:studio": "prisma studio",
    "embed:verify": "tsx scripts/verify-embedding-parity.ts",
    "data:export": "node scripts/export-revisions.mjs",
    "embed:index:py": ".venv/bin/python scripts/embed.py index --smoke-test",
