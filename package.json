    "@prisma/client": "^5.22.0",
    "groq-sdk": "^1.5.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.15",
    "next-intl": "^3.26.5",
    "openai": "^7.4.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
