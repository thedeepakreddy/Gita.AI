{
  "name": "gita-counsel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/__tests__/*.test.ts",
    "data:build": "node scripts/build-chapter.mjs --all",
    "data:rebuild": "node scripts/build-chapter.mjs --all --force",
    "embed:index": "tsx scripts/index-verses.ts --smoke-test",
