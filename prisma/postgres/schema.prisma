// GENERATED FILE — DO NOT EDIT.
//
// Produced from prisma/schema.prisma by scripts/gen-postgres.mjs.
// Edit the SQLite schema and re-run:  npm run db:postgres
//
// Prisma cannot take the datasource provider from an environment variable, so
// deploying on Postgres while developing on SQLite needs a second schema. This
// is that file, generated rather than maintained, because two hand-edited
// schemas drift and the drift only shows up as a failed production migration.
// Persistence for Gita Counsel.
//
// SQLite is used deliberately: no external service, no cost, and the data
// volume here is tiny. It does NOT survive a serverless deploy (Vercel's
// filesystem is ephemeral) — to deploy there, change `provider` to
// "postgresql" and point DATABASE_URL at a managed instance. No model
// changes are required for that swap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NextAuth models. Identity, plus the one counter the trial is metered on
// (User.trialMessagesUsed) — an allowance has to be counted against something,
// and the account is the only durable handle there is. The rules themselves
// live in src/lib/chat/keyResolution.ts, not here.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  /// Messages this account has spent from the operator-funded trial pool.
  /// Counts up to TRIAL_MESSAGE_LIMIT, after which the user must supply their
  /// own key. Never decremented — the trial is once per account, not a refill.
  trialMessagesUsed Int @default(0)

  /// "user" | "reviewer" | "admin". Reviewers may edit translations; admins may
  /// also promote reviewers and read the voice-guard log. An address listed in
  /// ADMIN_EMAILS is treated as admin whatever this column says, so a fresh
  /// deployment always has a way in and nobody can lock themselves out.
  role String @default("user")

  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  conversations Conversation[]
  bookmarks     Bookmark[]
  progress      ReadingProgress[]
  revisions     TranslationRevision[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// BYOK. The user's own provider key, encrypted at rest.
//
// Once a user has a key here it always wins, so nobody burns operator credit
// they don't need to. Before that, a new account may spend TRIAL_MESSAGE_LIMIT
// messages on the operator's own key — see User.trialMessagesUsed above and
// src/lib/chat/keyResolution.ts.
// ---------------------------------------------------------------------------

model ApiKey {
  id     String @id @default(cuid())
  userId String

  /// "gemini" | "groq" | "openai" | "anthropic"
  provider String

  /// AES-256-GCM ciphertext, base64. The plaintext key is never stored.
  ciphertext String
  /// Per-record random IV, base64.
  iv         String
  /// GCM authentication tag, base64. Detects tampering on decrypt.
  authTag    String
  /// Last 4 characters only, so the UI can show "…a1b2" without decrypting.
  keyHint    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One key per provider per user; saving again replaces it.
  @@unique([userId, provider])
}

// ---------------------------------------------------------------------------
// Chat history. Multiple named conversations per user, newest-first.
// ---------------------------------------------------------------------------

model Conversation {
  id     String @id @default(cuid())
  userId String

  /// Derived from the first user message; editable.
  title String

  /// Locale the conversation was held in, so it reopens in the right language.
  locale String @default("en")

  /// Which provider this conversation is being held with, for users who have
  /// saved more than one key. Null means "whatever resolves at send time" —
  /// the case for trial users and anyone with a single key. Pinned per
  /// conversation rather than per user so switching provider mid-thread is a
  /// deliberate act, not a global setting that silently rewrites history.
  provider String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String @id @default(cuid())
  conversationId String

  /// "user" | "assistant"
  role    String
  content String

  /// JSON array of the chapter.verse references the answer cited, e.g. ["2.47"],
  /// as returned by extractCitations() in src/lib/chat/prompt.ts.
  /// Null for user messages.
  citations String?

  /// True when this answer was paid for by the operator's trial key rather
  /// than the user's own. Drives the global daily cap and gives an audit trail
  /// for what the trial actually cost.
  usedTrialKey Boolean @default(false)

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([usedTrialKey, createdAt])
}

// ---------------------------------------------------------------------------
// Translation review.
//
// The corpus on disk (data/verses/**.json) ships public-domain placeholders.
// A revision here LAYERS OVER that file at read time rather than editing it,
// for two reasons: a deployed app may have no writable filesystem, and the
// original text must stay recoverable so a bad edit is never destructive.
//
// scripts/export-revisions.mjs folds approved revisions back into the JSON so
// the corpus can be re-embedded and handed on as plain files.
// ---------------------------------------------------------------------------

model TranslationRevision {
  id String @id @default(cuid())

  /// "bhagavad-gita:2:47" — matches Verse.id in the corpus.
  verseId String
  locale  String

  /// The replacement translation.
  text String

  /// "in-review" | "reviewed". Mirrors TranslationStatus in
  /// src/lib/verses/types.ts; "placeholder" never appears here, because the
  /// existence of a row means a human has touched it.
  status String @default("in-review")

  /// Provenance, carried so a handed-over corpus can still be audited.
  translator String?
  source     String?
  license    String?
  /// Free-form note from the reviewer, e.g. why a rendering was chosen.
  note       String?

  reviewedById String?
  reviewedBy   User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live revision per verse per language; editing again replaces it.
  @@unique([verseId, locale])
  @@index([locale, status])
}

// ---------------------------------------------------------------------------
// The voice guard's audit trail.
//
// looksLikeDivineFirstPerson() discards a reply that speaks as Krishna, and
// until now it did so leaving no trace. For an application intended for a
// temple, "the guard fired 4 times in 10,000 answers and stopped all four" is
// the evidence that earns trust — it cannot be shown without a record.
//
// The discarded reply is stored deliberately: reviewing what the model
// actually said is the only way to tell a genuine drift from a false positive
// in the pattern list. It is never shown to the person who asked.
// ---------------------------------------------------------------------------

model VoiceViolation {
  id String @id @default(cuid())

  /// Null if the account was deleted afterwards — the audit line survives.
  userId         String?
  conversationId String?

  provider String
  locale   String

  /// Source of the regex in DIVINE_FIRST_PERSON that matched.
  pattern String
  /// The exact span that tripped it, for reading the log at a glance.
  matched String

  /// What the person asked, and the reply that was refused and never stored
  /// as a Message.
  question String
  reply    String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Study aids. Both are per-user and deliberately thin.
// ---------------------------------------------------------------------------

model Bookmark {
  id     String @id @default(cuid())
  userId String

  /// "bhagavad-gita:2:47"
  verseId String
  note    String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, verseId])
  @@index([userId, createdAt])
}

model ReadingProgress {
  id     String @id @default(cuid())
  userId String

  scripture String
  /// Where the reader last was, so /study can offer "continue".
  chapter   Int
  verse     Int    @default(1)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scripture])
}
